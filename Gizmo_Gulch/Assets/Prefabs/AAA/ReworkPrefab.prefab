  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 588
  indentLevel: 0
  storyText: Well, from the afternoon to the late evening I usually stay at the bar.
    After my patrons come through I need to clean the establishment.
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
